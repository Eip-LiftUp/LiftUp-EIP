# Example environment file for docker-compose.yml (repository root).
# Copy it to `.env` (ignored by git) and adjust the values:
#   cp .env.example .env
# docker compose reads `.env` automatically. Never commit real secrets.

# Required: secret used to sign JWTs, at least 32 characters.
# Generate one with: openssl rand -hex 32
# `docker compose` refuses to start without it.
JWT_SECRET=change-me-dummy-secret-at-least-32-chars

# Optional, token lifetime in days (default: 7)
JWT_EXPIRATION_DAYS=7

# Optional, comma-separated browser origins allowed by CORS ("*" is refused).
# Production: set the public URL of the web app.
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Optional, login attempts per minute and per IP (default: 5)
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Base URL of the Python AI service, as seen FROM the backend container.
# The ai-service of docker-compose.yml is disabled, so by default the backend
# reaches a service running on the host (not "localhost": inside the container
# that is the container itself).
# If you enable the ai-service in docker-compose.yml, use http://ai-service:8000
AI_SERVICE_URL=http://host.docker.internal:8000

# Timeout of a program generation call, in seconds (default: 5)
AI_TIMEOUT_SECS=5

# Timeout of a video analysis call, in seconds (default: 120)
AI_ANALYSIS_TIMEOUT_SECS=120
