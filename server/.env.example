# Environment variables for LiftUp ML Service

# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:8000

# ML Model Settings
POSE_MODEL_PATH=data/models/pose_model.pt
CONFIDENCE_THRESHOLD=0.5

# Processing Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Logging
LOG_LEVEL=INFO
