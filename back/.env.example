# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://liftup_user:liftup_password@localhost:5432/liftup_db
DATABASE_MAX_CONNECTIONS=10

# Auth (JWT)
# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-dummy-secret-at-least-32-chars
# Optional, token lifetime in days (default: 7)
JWT_EXPIRATION_DAYS=7

# CORS
# Comma-separated list of origins allowed to call the API from a browser.
# "*" is refused. Default (dev): the Flutter web build served by nginx on port 8090.
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Rate limiting
# Login attempts allowed per minute and per IP (default: 5, must be > 0).
# Behind a reverse proxy, make sure it overwrites X-Forwarded-For (see src/rate_limit.rs).
LOGIN_RATE_LIMIT_PER_MINUTE=5

# AI service (Python ML engine)
# Base URL of the AI service (default: http://localhost:8000).
AI_SERVICE_URL=http://localhost:8000
# Timeout of a call to the AI service, in seconds (default: 5, must be > 0).
# If it fails or is too slow, the cached program is served instead.
AI_TIMEOUT_SECS=5

# Logging
RUST_LOG=liftup_backend=debug,tower_http=debug
